# ── Supabase ─────────────────────────────────────────────────────────────────
# Create a FREE project at https://supabase.com
# Then go to Project Settings → API to find these values.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # Service role secret (Settings → API → service_role)

# ── Auth ─────────────────────────────────────────────────────────────────────
# Any random string — change this before sharing the Vercel link
JWT_SECRET=change-me-in-production-use-a-long-random-string

# ── AI Coach (optional) ───────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
# If not set, the coach uses built-in fallback responses
# GROQ_API_KEY=gsk_...
